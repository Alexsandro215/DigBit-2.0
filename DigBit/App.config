<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
  <appSettings>
    <!-- true: pantalla completa, sin cerrar ni minimizar, y "Salir" solo cierra la sesion.
         Es como corre DigBit cuando es el shell de Windows en los equipos del laboratorio.
         La variable de entorno DIGBIT_MODO_KIOSCO=1 tiene prioridad sobre este valor. -->
    <add key="ModoKiosco" value="false" />
    <!-- Laboratorio en el que esta este equipo: el NOMBRE exacto de
         laboratorios.nombre_laboratorio (fase 6). Un codigo de acceso solo vale
         en su laboratorio. Vacio: en kiosco la app no arranca (lo dice en
         pantalla); en escritorio avisa en el log. La variable de entorno
         DIGBIT_LABORATORIO tiene prioridad. deploy\configurar_equipo.ps1 lo
         escribe con -Laboratorio. -->
    <add key="Laboratorio" value="" />
    <!-- Carpeta donde DigBit deja lo que NO se puede perder al reiniciar: las
         bitacoras que aun no llegaron al servidor, la copia local del horario y
         los registros. Los equipos del laboratorio tienen Deep Freeze y el disco
         del sistema vuelve atras en cada reinicio, asi que aqui va un ThawSpace
         (por convencion T:\DigBitDatos) o una particion sin congelar. Vacio:
         %LOCALAPPDATA%\DigBit, que con Deep Freeze se pierde. La variable de
         entorno DIGBIT_CARPETA_DATOS tiene prioridad. deploy\configurar_equipo.ps1
         lo escribe con -CarpetaDatos. -->
    <!-- Como se identifica ESTA maquina en la bitacora: el numero que este
         pegado en el equipo ("12", "LAB1-12"...). Vacio: el nombre de Windows,
         que si los equipos se llaman DESKTOP-A7F3K2 no le sirve de nada a quien
         tenga que ir a buscar la que falla. La variable de entorno
         DIGBIT_NUMERO_MAQUINA tiene prioridad. deploy\configurar_equipo.ps1 lo
         escribe con -NumeroMaquina. -->
    <add key="NumeroMaquina" value="" />
    <!-- Acceso de emergencia (solo equipos de laboratorio): el numero de serie
         de la memoria USB autorizada, HASHEADO con PBKDF2. Nunca en claro,
         porque este archivo lo puede leer el alumno. Lo escribe
         deploy\configurar_equipo.ps1 con -AutorizarMemoria. Vacio: la opcion
         avisa de que no hay memoria configurada y no abre nada. -->
    <add key="EmergenciaMemoria" value="" />
    <add key="CarpetaDatos" value="" />
  </appSettings>
  <!-- Las credenciales viven en connections.config, que no se versiona. -->
  <connectionStrings configSource="connections.config" />
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.IO.Pipelines" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Google.Protobuf" publicKeyToken="a7d26565bac4d604" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.25.3.0" newVersion="3.25.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="ZstdSharp" publicKeyToken="8d151af33a4ad5cf" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-0.7.5.0" newVersion="0.7.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="K4os.Compression.LZ4.Streams" publicKeyToken="2186fa9121ef231d" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.3.6.0" newVersion="1.3.6.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Logging.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>