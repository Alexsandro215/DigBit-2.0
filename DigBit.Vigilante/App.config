<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
  <appSettings>
    <!-- Carpeta donde el vigilante deja su log. Tiene que ser la MISMA que la de
         DigBit.exe.config: en los equipos con Deep Freeze, un ThawSpace (T:\DigBitDatos),
         porque %ProgramData% se borra en cada reinicio y el log es lo unico que
         queda para saber por que se cerro una sesion. Vacio: %ProgramData%\DigBit\logs.
         deploy\configurar_equipo.ps1 lo escribe con -CarpetaDatos. -->
    <add key="CarpetaDatos" value="" />
  </appSettings>
</configuration>
